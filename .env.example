# ── Stripe (optional) ────────────────────────────────────────────────────────
# Publishable key only. NEVER put a secret key (sk_...) in a VITE_ variable —
# it would be inlined into the browser bundle.
VITE_STRIPE_PUBLISHABLE_KEY=
# Public URL of the serverless endpoint (see server/stripe-checkout.ts).
VITE_STRIPE_CHECKOUT_ENDPOINT=

# Canonical site URL, used for Stripe success/cancel redirects.
VITE_SITE_URL=http://localhost:5173
